# Copy to .env (git-ignored) and fill locally. Never commit real values.
# Google Maps Platform key restricted to the Routes API. Leave blank until a
# paid-service spending cap is approved (decision D04/D10).
GOOGLE_MAPS_API_KEY=
# Opt in to live network tests (1 = run tests marked "live").
ROUTEWISE_LIVE_TESTS=0
# Override the OSRM base URL (defaults to the public demo server, research use only).
OSRM_BASE_URL=
