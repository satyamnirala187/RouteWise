# Copy to .env (git-ignored) and fill locally. Never commit real values.
# `scripts/dev-db.sh init` generates the database and secret entries for you.

# --- App (Phase 1)
ROUTEWISE_ENV=development                 # development | production
DATABASE_URL=postgresql+psycopg://<user>:<password>@127.0.0.1:54329/routewise_dev
TEST_DATABASE_URL=postgresql+psycopg://<user>:<password>@127.0.0.1:54329/routewise_test
ROUTEWISE_SECRET_KEY=<at least 32 random characters>
ROUTEWISE_PG_SUPERUSER_PASSWORD=<local cluster superuser password>
# Optional overrides
ROUTEWISE_COOKIE_SECURE=                  # default: true in production, false in development
ROUTEWISE_ALLOWED_ORIGINS=                # default: http://localhost:5173,http://127.0.0.1:5173,http://localhost:8000
ROUTEWISE_RESOLVE_SHORT_LINKS=            # default: true (maps.app.goo.gl / goo.gl only, via the pinned client)

# --- Phase 0 spike (inactive paid providers; leave blank, budget is INR 0)
GOOGLE_MAPS_API_KEY=
STADIA_API_KEY=
ROUTEWISE_LIVE_TESTS=0
OSRM_BASE_URL=
